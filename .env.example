# Primary Gemini API Key for ATS AI Generation & Copilot
# Get your API keys from: https://aistudio.google.com/
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Multi-Key Rotation & Quota Failover Pool (Optional but recommended to prevent 429 Rate Limits)
# The application automatically rotates through these keys when quota (20 requests/day free tier) is exhausted
GEMINI_API_KEY_1=your_first_backup_gemini_api_key
GEMINI_API_KEY_2=your_second_backup_gemini_api_key
GEMINI_API_KEY_3=your_third_backup_gemini_api_key

# Comma-separated Gemini API Keys (Alternative multi-key configuration)
# GEMINI_API_KEYS=key1,key2,key3

# Password used to decrypt the Master CV data file (data/master_cv.enc)
RESUME_PASSWORD=your_master_cv_decryption_password

# Production Application & Copilot URL
COPILOT_URL=https://my-agent-mauve-omega.vercel.app/